{
  "json.schemas": [
    {
      "fileMatch": [
        "/*electron-builder.json"
      ],
      "url": "https://json.schemastore.org/electron-builder"
    }
  ],
  "i18n-ally.localesPaths": ["app/renderer/locales"],
  "i18n-ally.sourceLanguage": "zh-CN",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.enabledParsers": ["json"],
  "i18n-ally.keepFulfilled": true,
  "i18n-ally.sortKeys": true,
  // 产物目录：构建/测试自动生成，从资源管理器与搜索中隐藏（源码仍在磁盘上，随时可删）
  "files.exclude": {
    "/build": true,
    "/dist": true,
    "/dist-electron": true,
    "/release": true,
    "/test-results": true,
    "/参考": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "/build": true,
    "/dist": true,
    "/dist-electron": true,
    "/release": true,
    "/test-results": true,
    "/参考": true,
    "**/node_modules": true
  }
}
