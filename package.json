{
  "name": "eletron-react-template",
  "productName": "Electron React Template",
  "version": "1.0.0",
  "private": true,
  "description": "Electron + React + TypeScript 桌面应用模板，基于 electron-vite-react 二次开发。",
  "license": "MIT",
  "author": "BluerAngala",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "packageManager": "pnpm@11.13.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/BluerAngala/eletron-react-template.git"
  },
  "bugs": {
    "url": "https://github.com/BluerAngala/eletron-react-template/issues"
  },
  "homepage": "https://github.com/BluerAngala/eletron-react-template#readme",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "installer-assets": "node scripts/generate-installer-assets.mjs",
    "rename": "node scripts/rename.mjs",
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "test:e2e": "pnpm pretest && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
